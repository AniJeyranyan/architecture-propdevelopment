<mxfile host="app.diagrams.net">
  <diagram name="Data Security Mind Map" id="data-security-mindmap">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n2" value="&lt;b&gt;Data Security&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;PropDevelopment&lt;br&gt;ISO/IEC 27001 / 27002&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1a3a5c;strokeColor=#0d2033;fontColor=#ffffff;fontSize=20;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="-130" y="690" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="n3" value="&lt;b&gt;Public data&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="-550" y="305" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;Company data&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left&quot;&gt;&amp;bull; Property catalog: residential complexes, layouts, prices, availability (Sales storefront, client-mart-estate-app)&lt;br&gt;&amp;bull; Public 3D tours and photos of show apartments (client-tour-app)&lt;br&gt;&amp;bull; Project declarations and construction progress (published by law, 214-FZ)&lt;br&gt;&amp;bull; Marketing content, news, promotions, press releases&lt;br&gt;&amp;bull; Public offer terms, storefront and mobile app texts&lt;br&gt;&amp;bull; Public utility tariffs and general house rules&lt;br&gt;&amp;bull; Public contacts of management companies and partners&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="-970" y="185" width="360" height="330" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b&gt;Data leak&lt;/b&gt;&lt;br&gt;Insignificant" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="-1270" y="38" width="240" height="64" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n9" value="The data is published on purpose, so disclosure causes no harm. The only sensitive moment is premature publication of unreleased prices or new complexes, which is a minor commercial loss, not a security incident." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="-1800" y="8" width="470" height="124" as="geometry"/></mxCell>
        <mxCell id="e10" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n11" value="&lt;b&gt;Data loss&lt;/b&gt;&lt;br&gt;Insignificant" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="-1270" y="178" width="240" height="64" as="geometry"/></mxCell>
        <mxCell id="e12" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="n5" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n13" value="The catalog is generated from client-mart-estate-db and marketing sources, and all DBs are backed up. A loss means short storefront downtime and republishing; no unique data is lost." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="-1800" y="148" width="470" height="124" as="geometry"/></mxCell>
        <mxCell id="e14" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="n11" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n15" value="&lt;b&gt;Data distortion&lt;/b&gt;&lt;br&gt;Significant" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="-1270" y="318" width="240" height="64" as="geometry"/></mxCell>
        <mxCell id="e16" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="n5" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n17" value="A wrong price or availability on the storefront is a public offer: clients book at the wrong price, consumer-protection claims and reputational damage follow. client-crm-app publishes the catalog via Kafka without integrity control, so tampering or a bad sync is possible." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="-1800" y="288" width="470" height="124" as="geometry"/></mxCell>
        <mxCell id="e18" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#d6b656;" edge="1" parent="1" source="n15" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n19" value="&lt;b&gt;Poor-quality data&lt;/b&gt;&lt;br&gt;Significant" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="-1270" y="458" width="240" height="64" as="geometry"/></mxCell>
        <mxCell id="e20" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="n5" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n21" value="Property data lives in client-mart-estate-db and is also re-published by client-crm-app with no single master. Outdated availability leads to double bookings, client complaints and lower conversion of the main sales channel." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="-1800" y="428" width="470" height="124" as="geometry"/></mxCell>
        <mxCell id="e22" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#d6b656;" edge="1" parent="1" source="n19" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n23" value="&lt;b&gt;Data devaluation&lt;/b&gt;&lt;br&gt;Insignificant" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="-1270" y="598" width="240" height="64" as="geometry"/></mxCell>
        <mxCell id="e24" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="n5" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n25" value="Public data has little intrinsic value and is meant to be copied. Competitors scraping prices or layouts is expected and does not reduce the company's ability to sell." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="-1800" y="568" width="470" height="124" as="geometry"/></mxCell>
        <mxCell id="e26" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="n23" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n27" value="&lt;b&gt;Internal data&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=18;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="-550" y="1105" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="e28" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="n2" target="n27"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n29" value="&lt;b&gt;Company data&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left&quot;&gt;&amp;bull; Aggregated sales and booking statistics, BI reports and dashboards (DWH, BI)&lt;br&gt;&amp;bull; Current and capital repair plans and history per building (tenant-core-app)&lt;br&gt;&amp;bull; Management company notices for residents of a building&lt;br&gt;&amp;bull; Building-level smart home configuration: floor automation, device inventory (not linked to a person)&lt;br&gt;&amp;bull; Architecture docs, C4 diagrams, integration specs, internal API contracts&lt;br&gt;&amp;bull; Internal regulations, processes, org structure, employee directory&lt;br&gt;&amp;bull; Aggregated, non-personal online tour and inspection statistics&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="-970" y="985" width="360" height="330" as="geometry"/></mxCell>
        <mxCell id="e30" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="n27" target="n29"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n31" value="&lt;b&gt;Data leak&lt;/b&gt;&lt;br&gt;Significant" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="-1270" y="838" width="240" height="64" as="geometry"/></mxCell>
        <mxCell id="e32" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="n29" target="n31"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n33" value="No personal data, but architecture docs, API contracts and integration specs reveal the attack surface (unprotected partner APIs, CDC flows). Sales statistics are valuable to competitors. The harm is real but limited and not subject to regulator fines." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="-1800" y="808" width="470" height="124" as="geometry"/></mxCell>
        <mxCell id="e34" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#d6b656;" edge="1" parent="1" source="n31" target="n33"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n35" value="&lt;b&gt;Data loss&lt;/b&gt;&lt;br&gt;Significant" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="-1270" y="978" width="240" height="64" as="geometry"/></mxCell>
        <mxCell id="e36" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="n29" target="n35"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n37" value="Repair history is an obligation of the management company and owners rely on it in the app; reports drive management decisions. Backups exist, but the DWH is filled by raw CDC, so rebuilding marts and reports takes a long time." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="-1800" y="948" width="470" height="124" as="geometry"/></mxCell>
        <mxCell id="e38" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#d6b656;" edge="1" parent="1" source="n35" target="n37"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n39" value="&lt;b&gt;Data distortion&lt;/b&gt;&lt;br&gt;Significant" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="-1270" y="1118" width="240" height="64" as="geometry"/></mxCell>
        <mxCell id="e40" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="n29" target="n39"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n41" value="Wrong repair schedules mislead owners and cause complaints; distorted reports lead to wrong business decisions. Data processing systems have no access restrictions, so any user with access can change data unnoticed." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="-1800" y="1088" width="470" height="124" as="geometry"/></mxCell>
        <mxCell id="e42" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#d6b656;" edge="1" parent="1" source="n39" target="n41"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n43" value="&lt;b&gt;Poor-quality data&lt;/b&gt;&lt;br&gt;Critical" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="-1270" y="1258" width="240" height="64" as="geometry"/></mxCell>
        <mxCell id="e44" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="n29" target="n43"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n45" value="Five DBs are copied to Greenplum as raw CDC with no data catalog, lineage or quality checks, and people are duplicated across two CRMs. Reports are unreliable, which directly blocks the company's BI/ML/AI plans." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="-1800" y="1228" width="470" height="124" as="geometry"/></mxCell>
        <mxCell id="e46" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="n43" target="n45"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n47" value="&lt;b&gt;Data devaluation&lt;/b&gt;&lt;br&gt;Significant" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="-1270" y="1398" width="240" height="64" as="geometry"/></mxCell>
        <mxCell id="e48" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="n29" target="n47"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n49" value="Accumulated data is the basis of the planned data products. Without owners, metadata and access rules nobody can trust or reuse it, so the investment in collecting and storing it brings no value." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="-1800" y="1368" width="470" height="124" as="geometry"/></mxCell>
        <mxCell id="e50" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#d6b656;" edge="1" parent="1" source="n47" target="n49"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n51" value="&lt;b&gt;Confidential data&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=18;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="320" y="305" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="e52" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="n2" target="n51"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n53" value="&lt;b&gt;Company data&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left&quot;&gt;&amp;bull; Client personal data from booking: full name, phone, email (client-crm-app, crm-db)&lt;br&gt;&amp;bull; Extended form and deal data: passport, SNILS, TIN, address, marital status, income, mortgage (client-mart-db)&lt;br&gt;&amp;bull; Purchase contracts, prices, payment schedules, deal statuses, documents sent via SMEV&lt;br&gt;&amp;bull; Owner personal data: name, contacts, apartment, ownership, personal account numbers (owner CRM, crm-tenant-db)&lt;br&gt;&amp;bull; Utility bills, payment history, meter readings (tenant-core-db)&lt;br&gt;&amp;bull; Personal inspection and online tour history linked to a client&lt;br&gt;&amp;bull; Smart home event logs: presence, door lock open/close history&lt;br&gt;&amp;bull; Accounting data: settlements, payroll, counterparties (accountant-service-1)&lt;br&gt;&amp;bull; Data exchanged with management companies and utility providers (partner APIs)&lt;br&gt;&amp;bull; Employee personal data&lt;br&gt;&amp;bull; Raw copies of all of the above in Greenplum / S3&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="610" y="105" width="360" height="490" as="geometry"/></mxCell>
        <mxCell id="e54" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="n51" target="n53"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n55" value="&lt;b&gt;Data leak&lt;/b&gt;&lt;br&gt;Critical" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1030" y="38" width="240" height="64" as="geometry"/></mxCell>
        <mxCell id="e56" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="n53" target="n55"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n57" value="Mass personal data of clients and owners: a 152-FZ breach, mandatory notification of Roskomnadzor within 24/72 h, turnover-based fines, lawsuits and press coverage (as with the competitor). The risk has already materialised: users see other clients' names, partner APIs expose PD and allow cross-company access, and raw PD sits in the DWH without restrictions." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1330" y="8" width="470" height="124" as="geometry"/></mxCell>
        <mxCell id="e58" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="n55" target="n57"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n59" value="&lt;b&gt;Data loss&lt;/b&gt;&lt;br&gt;Significant" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1030" y="178" width="240" height="64" as="geometry"/></mxCell>
        <mxCell id="e60" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="n53" target="n59"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n61" value="Losing deal, ownership and payment data stops legally significant processes and means collecting documents from clients again. Backups to the required depth exist, so data is recoverable, but copies in several systems with no master make the restored state inconsistent." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1330" y="148" width="470" height="124" as="geometry"/></mxCell>
        <mxCell id="e62" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#d6b656;" edge="1" parent="1" source="n59" target="n61"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n63" value="&lt;b&gt;Data distortion&lt;/b&gt;&lt;br&gt;Critical" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1030" y="318" width="240" height="64" as="geometry"/></mxCell>
        <mxCell id="e64" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="n53" target="n63"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n65" value="Mixed-up records (another client's name in the personal account), partners able to change other companies' client data and uncontrolled CDC can corrupt deals, ownership data and bills. Wrong data in a contract or SMEV registration has legal consequences, and 152-FZ requires PD to be accurate." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1330" y="288" width="470" height="124" as="geometry"/></mxCell>
        <mxCell id="e66" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="n63" target="n65"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n67" value="&lt;b&gt;Poor-quality data&lt;/b&gt;&lt;br&gt;Critical" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1030" y="458" width="240" height="64" as="geometry"/></mxCell>
        <mxCell id="e68" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="n53" target="n67"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n69" value="Several uncoordinated registration points (auth-service-1, client-crm-app, owner CRM) create duplicates and conflicting profiles with no master record. This is the root cause of clients seeing another person's name in their account (the #1 customer complaint) and leads to failed online deals and wrong utility bills." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1330" y="428" width="470" height="124" as="geometry"/></mxCell>
        <mxCell id="e70" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="n67" target="n69"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n71" value="&lt;b&gt;Data devaluation&lt;/b&gt;&lt;br&gt;Significant" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1030" y="598" width="240" height="64" as="geometry"/></mxCell>
        <mxCell id="e72" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="n53" target="n71"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n73" value="PD collected without a clear purpose and consent cannot legally be used for ML/AI (152-FZ purpose limitation), so the data asset loses value. After a leak, clients trust the company less and share less data, which hurts sales and new services." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1330" y="568" width="470" height="124" as="geometry"/></mxCell>
        <mxCell id="e74" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#d6b656;" edge="1" parent="1" source="n71" target="n73"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n75" value="&lt;b&gt;Secret data&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=18;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="320" y="1105" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="e76" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="n2" target="n75"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n77" value="&lt;b&gt;Company data&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left&quot;&gt;&amp;bull; Authentication data: password hashes, sessions, tokens, Keycloak realm keys (auth-service-1 / auth-db-1, shared by clients and owners)&lt;br&gt;&amp;bull; Active Directory credentials, privileged and service accounts&lt;br&gt;&amp;bull; Cryptographic keys, TLS certificates, DB and CDC connection credentials, CI/CD secrets&lt;br&gt;&amp;bull; Company electronic signature keys and SMEV certificates for government registration&lt;br&gt;&amp;bull; Payment system and partner API keys / client secrets&lt;br&gt;&amp;bull; Smart lock digital keys, access codes, device control credentials&lt;br&gt;&amp;bull; Security information: firewall rules, vulnerability scans, audit and pentest results, incidents&lt;br&gt;&amp;bull; Trade secrets: land acquisition plans, pricing strategy, M&amp;amp;A and investment plans&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="610" y="965" width="360" height="370" as="geometry"/></mxCell>
        <mxCell id="e78" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="n75" target="n77"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n79" value="&lt;b&gt;Data leak&lt;/b&gt;&lt;br&gt;Critical" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1030" y="838" width="240" height="64" as="geometry"/></mxCell>
        <mxCell id="e80" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="n77" target="n79"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n81" value="A leaked Keycloak key or admin password gives access to every client AND owner account at once, because one auth-service-1 serves both. Leaked smart lock keys mean physical entry into apartments; leaked signature/SMEV keys allow fraudulent registration actions with property." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1330" y="808" width="470" height="124" as="geometry"/></mxCell>
        <mxCell id="e82" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="n79" target="n81"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n83" value="&lt;b&gt;Data loss&lt;/b&gt;&lt;br&gt;Critical" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1030" y="978" width="240" height="64" as="geometry"/></mxCell>
        <mxCell id="e84" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="n77" target="n83"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n85" value="Losing Keycloak keys or the auth DB locks out every client and owner; losing signature keys stops online deals; losing lock credentials can leave residents unable to open their doors. Signing keys cannot be restored, only reissued, which takes time." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1330" y="948" width="470" height="124" as="geometry"/></mxCell>
        <mxCell id="e86" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="n83" target="n85"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n87" value="&lt;b&gt;Data distortion&lt;/b&gt;&lt;br&gt;Critical" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1030" y="1118" width="240" height="64" as="geometry"/></mxCell>
        <mxCell id="e88" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="n77" target="n87"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n89" value="Tampering with roles in Keycloak/AD, firewall rules or lock permissions gives silent privilege escalation and bypasses every other control. With one security specialist who does not see all changes, such modifications may go unnoticed." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1330" y="1088" width="470" height="124" as="geometry"/></mxCell>
        <mxCell id="e90" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="n87" target="n89"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n91" value="&lt;b&gt;Poor-quality data&lt;/b&gt;&lt;br&gt;Significant" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1030" y="1258" width="240" height="64" as="geometry"/></mxCell>
        <mxCell id="e92" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="n77" target="n91"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n93" value="Orphaned accounts after the IT leadership changes, unrotated secrets and an AD shared by finance, CRMs and DWH (the AD roles even look swapped in the diagram) widen the attack surface. Not an incident by itself, but it makes leaks and escalation much easier." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1330" y="1228" width="470" height="124" as="geometry"/></mxCell>
        <mxCell id="e94" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#d6b656;" edge="1" parent="1" source="n91" target="n93"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n95" value="&lt;b&gt;Data devaluation&lt;/b&gt;&lt;br&gt;Significant" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1030" y="1398" width="240" height="64" as="geometry"/></mxCell>
        <mxCell id="e96" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="n77" target="n95"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n97" value="A secret loses all protective value once it is shared or exposed: one Keycloak for two domains, one AD for several domains. It must then be rotated and reissued at high cost; leaked trade secrets lose their competitive value permanently." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1330" y="1368" width="470" height="124" as="geometry"/></mxCell>
        <mxCell id="e98" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#d6b656;" edge="1" parent="1" source="n95" target="n97"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n99" value="&lt;b&gt;Insignificant&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-135" y="-150" width="90" height="36" as="geometry"/></mxCell>
        <mxCell id="n100" value="&lt;b&gt;Significant&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-45" y="-150" width="90" height="36" as="geometry"/></mxCell>
        <mxCell id="n101" value="&lt;b&gt;Critical&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="45" y="-150" width="90" height="36" as="geometry"/></mxCell>
        <mxCell id="n102" value="&lt;b&gt;Risk rating scale&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="-135" y="-190" width="270" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
